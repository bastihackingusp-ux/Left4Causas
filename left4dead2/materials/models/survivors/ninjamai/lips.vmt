"VertexLitGeneric"
{	
	"$basetexture" 			"models\survivors\ninjamai\Face_D"
	"$bumpmap" 			"models\survivors\ninjamai\Face_N"
	"$nocull" 				"1"
	"$nodecal" 			"1"
	"$model" 				"1"
	//$color2				"[200 1.1 1.1]"
	$nocompress			1
	//$translucent			1
	//$blendtintbybasealpha 		1

	"$phong" 				"1"
	//$phongdisablehalflambert 		"1"
	//$BaseMapLuminancePhongMask 	1
	//$basemapalphaphongmask		1
	$BaseMapLuminancePhongMask 	1
	"$phongboost" 			"20"
	$phongfresnelranges 		"[.2 .5 25]"
	//$phongexponent			"4"
	"$phongexponent" 		"10"
	//"$phongtint"			"[.85 .85 1]"
	$phongalbedotint 			1

	"$envmap" 			"env_cubemap"
	"$envmaptint" 			"[.01 .01 .01]"	
