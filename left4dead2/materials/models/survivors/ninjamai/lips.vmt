	$envmapFresnelMinMaxExp		 "[0 1 .4]"

	"$rimlight" 			"1" 
	"$rimlightexponent" 			"20"
	"$rimlightboost" 			"5"
	$rimmask				1

	"$lightwarptexture" 			"models\survivors\ninjamai\Body_LW2"
	$ambientocclusion 			1
}