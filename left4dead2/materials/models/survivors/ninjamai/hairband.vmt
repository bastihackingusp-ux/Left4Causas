"VertexlitGeneric"
{
	"$basetexture" 		"models\survivors\ninjamai/Hairband_D"
	"$bumpmap" 		"models\survivors\ninjamai/Hairband_N"
	"$nocull" 			"1"
	"$nodecal" 		"1"
	"$model" 			"1"
	
	"$phong" 			"1"
	$phongdisablehalflambert 	"0"
	"$phongalbedotint" 		"1"
	"$phongalbedoboost" 	"20"
	"$phongboost" 		"2"
	$phongexponent		"10"
	"$phongfresnelranges"           	"[3 1.0 40]"

	"$normalmapalphaenvmapmask" 1
	"$envmap" 		"env_cubemap"
	$envmapfresnel 1
	$envmapFresnelMinMaxExp "[0 1 .4]"
	$envmaptint 		"[0.001 0.001 0.001]"

	"$rimlight" 		"1" 
	"$rimlightexponent" 		"20"
	"$rimlightboost" 		"1"

	"$detail"				"models\survivors\ninjamai\Outfit_Detail"
	"$detailscale" 			"22"
	$detailblendfactor			1.75

	$ambientocclusion 		1
	"$lightwarptexture"	 	"models\survivors\ninjamai/Outfit_LW"
}
